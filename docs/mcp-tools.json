        "type": "object",
        "properties": {
          "base": {
            "type": "string",
            "description": "Git revision or range to diff against, e.g. \"main\", \"HEAD~3\", \"origin/main...HEAD\". Omit for uncommitted work (staged, unstaged, untracked)."
          },
          "detail": {
            "type": "boolean",
            "description": "List every changed symbol instead of the first 15.",
            "default": false
          }
        }
      },
