  "tools": [
    {
      "name": "codebase_semantic_search",
      "description": "Find code from a description when you do not know the identifiers (Chinese or English; hybrid keyword + symbol + vector search). For an exact identifier or string literal, plain grep is faster and complete.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "hybrid",
              "lexical"
            ],
            "default": "hybrid"
          },
          "query": {
            "type": "string",
            "description": "Semantic explanation of what you are looking for."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum chunks to return (default 5).",
            "default": 5,
            "minimum": 1,
            "maximum": 50
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "cursor": {
            "type": "string",
            "description": "Continue using pagination.next_cursor; query and filters must remain unchanged."
          },
          "explain": {
            "type": "boolean",
            "default": false,
            "description": "Explain matched query terms, synonym sources, layer ranks, and data-access evidence."
          },
          "file_pattern": {
            "type": "string",
            "description": "File glob, e.g. *Repository*.cs"
          },
          "language": {
            "type": "string",
            "enum": [
              "csharp",
              "python",
              "javascript",
              "typescript",
              "tsx",
              "text"
            ]
          },
          "related": {
            "type": "boolean",
            "description": "Also list files linked to the top hits in the dependency graph.",
            "default": false
          },
          "detail": {
            "type": "boolean",
            "default": false,
            "description": "Return full structured nested collections; result limits and lookup bounds still apply."
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "result_type": {
            "type": "string",
            "const": "codebase_semantic_search"
          },
          "query": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file_path",
                "start_line",
                "end_line",
                "snippet",
                "score",
                "matched_by"
              ],
              "properties": {
                "file_path": {
                  "type": "string"
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "snippet": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "matched_by": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "related_files": {
            "type": "array"
          },
          "truncation": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "total",
                "returned"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "total": {
                  "type": "integer"
                },
                "returned": {
                  "type": "integer"
                }
              }
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "hybrid",
              "lexical"
            ]
          }
        },
        "required": [
          "schema_version",
          "result_type",
          "query",
          "results",
          "related_files"
        ],
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "codebase_get_symbol_relations",
      "description": "Who calls a method (resolved through interfaces / DI to the implementation, with confidence levels), what it calls, and who implements or inherits a type. Use instead of grep when the call goes through an interface. Overloaded names: pass Type.Method.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbol_name": {
            "type": "string",
            "description": "Class, interface or method name; \"Type.Method\" or a full qualified name picks one class, e.g. \"IExistOpenHandleService\" or \"SFC_MLotRepository.InsertAsync\"."
          },
          "relation_direction": {
            "type": "string",
            "enum": [
              "upstream",
              "downstream",
              "both"
            ]
          },
          "detail": {
            "type": "boolean",
            "default": false,
            "description": "Return full structured nested collections; result limits and lookup bounds still apply."
          }
        },
        "required": [
          "symbol_name"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "result_type": {
            "type": "string",
            "const": "codebase_get_symbol_relations"
          },
          "symbol": {
            "type": "string"
          },
          "definitions": {
            "type": "array"
          },
          "truncation": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "total",
                "returned"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "total": {
                  "type": "integer"
                },
                "returned": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "required": [
          "schema_version",
          "result_type",
          "symbol",
          "definitions"
        ],
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "codebase_get_optimized_context",
      "description": "Return only the relevant lines around focus lines of a file to minimise token usage.",
