          "call_depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "default": 8
          },
          "detail": {
            "type": "boolean",
            "description": "List every entry instead of the 5-entry summary.",
            "default": false
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "Page size per section."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "confidence": {
            "type": "string",
            "enum": [
              "confirmed",
              "probable",
              "uncertain"
            ]
          }
        },
        "required": [
          "object_name"
